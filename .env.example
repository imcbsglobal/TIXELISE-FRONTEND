# Copy to .env.development or .env.production and adjust.
# Must include the /api/v1 prefix. Anything with VITE_ ends up in the browser
# bundle, so never put secrets here.

# Default in code (used when no env file sets VITE_API_URL):
VITE_API_URL=https://tixelise.trelliscoerp.com/api/v1

# Backend on this machine instead:
# VITE_API_URL=http://127.0.0.1:8000/api/v1

# Same-origin deployment behind one host (SPA served by the API's domain):
# VITE_API_URL=/api/v1
